# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required on Vercel. On Replit this is auto-injected as AI_INTEGRATIONS_OPENAI_API_KEY
# by the Replit OpenAI integration — you do NOT need to set it there.
OPENAI_API_KEY=sk-...

# ── Database ──────────────────────────────────────────────────────────────────
# Optional. Session logging is disabled gracefully when absent.
# On Replit: auto-injected by the Replit PostgreSQL provisioner.
# On Vercel: point to a publicly accessible PostgreSQL instance (e.g. Neon, Supabase).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Replit-managed Clerk keys (auto-injected on Replit via the Auth pane).
# On Vercel: create a Clerk app at clerk.com and set these in Project Settings.
CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# ── Replit-specific (do not set on Vercel) ────────────────────────────────────
# These are auto-provided by Replit's OpenAI AI integration proxy.
# The api/_lib/openai.ts client prefers these when present.
# AI_INTEGRATIONS_OPENAI_API_KEY=...
# AI_INTEGRATIONS_OPENAI_BASE_URL=...
